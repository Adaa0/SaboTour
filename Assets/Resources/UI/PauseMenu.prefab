--- !u!114 &1927008564503788530
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 925254337019847516}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: UnityEngine.UI::UnityEngine.UI.Text
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 10102, guid: 0000000000000000e000000000000000, type: 0}
    m_FontSize: 24
    m_FontStyle: 1
    m_BestFit: 0
    m_MinSize: 2
    m_MaxSize: 40
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 1
    m_LineSpacing: 1
  m_Text: "SaboTour asimetrik bir yar\u0131\u015F oyunu: bir oyuncu SABOTAJCI, geri
    kalan herkes YARI\u015E\xC7I.\n\nKAZANMA\n\u2022 Yar\u0131\u015F\xE7\u0131lar
    turlar\u0131n\u0131 bitirirse yar\u0131\u015F\xE7\u0131lar kazan\u0131r.\n\u2022
    S\xFCre dolmadan kimse bitiremezse sabotajc\u0131 kazan\u0131r.\n\nYARI\u015E\xC7I
    KONTROLLER\u0130\n\u2022 W / S \u2014 gaz ve fren\n\u2022 A / D \u2014 direksiyon\n\u2022
    Space \u2014 el freni (drift)\n\u2022 ESC \u2014 men\xFC\nPistten \xE7ok uzakla\u015F\u0131rsan
    ya da bir checkpoint'i atlarsan otomatik olarak geri \u0131\u015F\u0131nlan\u0131rs\u0131n.\n\nSABOTAJCI
    KONTROLLER\u0130\n\u2022 W A S D \u2014 y\xFCr\xFC, Shift \u2014 ko\u015F, Space
    \u2014 z\u0131pla\n\u2022 Fare \u2014 bak, Sol t\u0131k \u2014 etkile\u015Fim\n\u2022
    ESC \u2014 imleci serbest b\u0131rak / men\xFC\n\nSABOTAJCI NE YAPAR\nKulenin
    i\xE7indeki masada pistin haritas\u0131 var. S\u0131rayla:\n1. Haritadan bir
    checkpoint'e t\u0131kla (se\xE7ilince k\u0131rm\u0131z\u0131 olur).\n2. Bir skil
    butonuna bas (se\xE7ili buton bas\u0131l\u0131 kal\u0131r).\n3. B\xFCy\xFCk k\u0131rm\u0131z\u0131
    butona bas\u0131p tuza\u011F\u0131 ate\u015Fle.\n\nButon bas\u0131l\u0131 ve
    S\xD6N\xDCKSE o skil \u015Farj oluyordur \u2014 \xFCzerine bak\u0131nca kalan
    saniye g\xF6r\xFCn\xFCr. Ye\u015Fil marker haz\u0131r checkpoint, k\u0131rm\u0131z\u0131
    marker se\xE7ili ya da az \xF6nce tuzaklanm\u0131\u015F demektir.\n\n\xDC\xC7
    SK\u0130L\n\u2022 Buz Bombas\u0131 (mavi) \u2014 checkpoint'e bomba d\xFC\u015Fer,
    ara\xE7lar\u0131 savurur ve yeri kayganla\u015Ft\u0131r\u0131r.\n\u2022 Tavuk
    S\xFCr\xFCs\xFC (sar\u0131) \u2014 piste tavuklar salar, \xE7arpan yava\u015Flar.\n\u2022
    Motor Ar\u0131zas\u0131 (turuncu) \u2014 o checkpoint'ten ge\xE7en \u0130LK ara\xE7
    birka\xE7 saniye g\xFC\xE7 kaybeder."
